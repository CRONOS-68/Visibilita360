# ===== Chiave per l'analisi delle foto (ne basta UNA) =====
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# oppure Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Se hai entrambe le chiavi, scegli quale usare: openai | anthropic
AI_PROVIDER=

# ===== Modelli (facoltativi) =====
# OpenAI: modello con visione. Il livello di ragionamento (low | medium | high)
# va lasciato vuoto con modelli che non ragionano, come gpt-4.1.
OPENAI_MODEL=gpt-5.5
OPENAI_EFFORT=medium
# Claude
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# ===== Server =====
# Token che il telefono deve inviare per usare l'analisi foto.
# Impostalo sempre se il server è raggiungibile da internet, poi inseriscilo
# nell'app in Profilo > Token server.
APP_TOKEN=
PORT=8787

# Facoltativo: HTTPS diretto dal server (serve per la scansione live del codice a barre)
# TLS_CERT=/percorso/fullchain.pem
# TLS_KEY=/percorso/privkey.pem
