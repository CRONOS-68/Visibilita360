# Chiave API Anthropic (https://console.anthropic.com) - resta SOLO sul server
ANTHROPIC_API_KEY=sk-ant-...

# Facoltativo: token che il telefono deve inviare per usare l'analisi foto.
# Impostalo sempre se il server è raggiungibile da internet, poi inseriscilo
# nell'app in Impostazioni > Token server.
APP_TOKEN=

# Porta del server (default 8787)
PORT=8787

# Modello e livello di ragionamento usati per l'analisi delle foto
CLAUDE_MODEL=claude-opus-5
# low | medium | high  (medium = buon compromesso tra precisione e attesa)
CLAUDE_EFFORT=medium

# Facoltativo: HTTPS diretto dal server (serve per la scansione live del codice a barre)
# TLS_CERT=/percorso/fullchain.pem
# TLS_KEY=/percorso/privkey.pem
